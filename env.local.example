# Local development only. Do not replace these values with production secrets.
PLATFORM_ENV=development
PLATFORM_NAME=FlowBiz AI Platform Local
PLATFORM_VERSION=0.1.0-local
PLATFORM_LOG_LEVEL=INFO
PLATFORM_DOCS_ENABLED=true

PLATFORM_AUTH_MODE=disabled
PLATFORM_AUTH_STORE_MODE=json
PLATFORM_AUTH_SQLITE_PATH=platform_data/platform_auth.db
PLATFORM_REQUIRED_API_KEYS=
PLATFORM_AUTH_API_KEYS_JSON=[]
PLATFORM_AUTH_API_KEYS_JSON_FILE=

PLATFORM_WORKFLOW_EVENTS_SQLITE_PATH=platform_data/workflow_events.db
PLATFORM_APPROVAL_GATE_SQLITE_PATH=platform_data/approval_gate.db
PLATFORM_WORKFLOW_RUNNER_DISPATCH_URL=
PLATFORM_WORKFLOW_CALLBACK_SHARED_SECRET=
PLATFORM_PLATFORM_PUBLIC_BASE_URL=http://localhost:8100

# Disposable local PostgreSQL service from docker-compose.yml.
PLATFORM_DATABASE_URL=postgresql+psycopg://flowbiz_local:flowbiz_local_only@postgres:5432/flowbiz_platform_local
PLATFORM_DATABASE_URL_FILE=

# Level 1 local mode never dispatches work to Hermes.
PLATFORM_RUNNER_ENABLED=false
PLATFORM_RUNNER_DISPATCH_URL=
PLATFORM_RUNNER_DISPATCH_TOKEN=
PLATFORM_RUNNER_DISPATCH_TOKEN_FILE=
PLATFORM_RUNNER_CALLBACK_SECRET=
PLATFORM_RUNNER_CALLBACK_SECRET_FILE=
PLATFORM_JOB_ADMIN_TOKEN=
PLATFORM_JOB_ADMIN_TOKEN_FILE=

PLATFORM_RATE_LIMIT_MODE=noop
PLATFORM_RATE_LIMIT_RPM=60
PLATFORM_RATE_LIMIT_REDIS_URL=redis://localhost:6379/0
PLATFORM_RATE_LIMIT_REDIS_PREFIX=flowbiz:local:rl
PLATFORM_LLM_PROVIDER=stub
PLATFORM_LLM_MODEL=stub-echo
PLATFORM_SECRET_PROVIDER=env
PLATFORM_SECRET_FILE_PATH=secrets.local.json
PLATFORM_LLM_TIMEOUT_SECONDS=30
PLATFORM_OPENAI_BASE_URL=https://api.openai.com/v1
PLATFORM_OPENAI_API_KEY_SECRET_NAME=OPENAI_API_KEY
PLATFORM_METRICS_MODE=log
PLATFORM_TRACING_MODE=disabled
PLATFORM_ALERTS_MODE=disabled
PLATFORM_OPERATOR_UI_ENABLED=false
