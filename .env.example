PLATFORM_ENV=development
PLATFORM_NAME=FlowBiz AI Platform
PLATFORM_VERSION=0.1.0
PLATFORM_LOG_LEVEL=INFO
PLATFORM_AUTH_MODE=disabled
PLATFORM_AUTH_STORE_MODE=json
PLATFORM_AUTH_SQLITE_PATH=platform_data/platform_auth.db
PLATFORM_REQUIRED_API_KEYS=
# JSON list of hashed key records (bootstrap-only; replace with DB later)
# Example:
# PLATFORM_AUTH_API_KEYS_JSON=[{"key_id":"demo","secret_hash":"<sha256>","scopes":["platform:chat"]}]
PLATFORM_AUTH_API_KEYS_JSON=[]
PLATFORM_AUTH_API_KEYS_JSON_FILE=

# Supabase JWT validation placeholders only. Do not commit production values.
PLATFORM_SUPABASE_JWT_ISSUER=
PLATFORM_SUPABASE_JWT_AUDIENCE=
PLATFORM_SUPABASE_JWKS_URL=
PLATFORM_SUPABASE_JWKS_CACHE_SECONDS=300
PLATFORM_SUPABASE_JWKS_TIMEOUT_SECONDS=2
PLATFORM_SUPABASE_JWT_CLOCK_SKEW_SECONDS=30

# Local workflow bootstrap state lives in this repo by default.
PLATFORM_WORKFLOW_EVENTS_SQLITE_PATH=platform_data/workflow_events.db

# Leave runner dispatch disabled for the default local smoke path.
# Set both values only when you want to exercise dispatch/callback flows.
PLATFORM_WORKFLOW_RUNNER_DISPATCH_URL=
PLATFORM_WORKFLOW_CALLBACK_SHARED_SECRET=
PLATFORM_PLATFORM_PUBLIC_BASE_URL=http://localhost:8100

# Core v0.2.3 Platform-runner runtime. Use *_FILE settings in production.
PLATFORM_DATABASE_URL_FILE=
PLATFORM_RUNNER_ENABLED=false
PLATFORM_RUNNER_DISPATCH_URL=http://localhost:9119/v1/runner/dispatch
PLATFORM_RUNNER_ID=hermes-readonly-1
PLATFORM_RUNNER_DISPATCH_TOKEN_FILE=
PLATFORM_RUNNER_CALLBACK_SECRET_FILE=
PLATFORM_JOB_ADMIN_TOKEN_FILE=
PLATFORM_PLATFORM_INTERNAL_BASE_URL=http://platform:8100

# Local bootstrap defaults to the stub provider so the app can start
# without external model or secret dependencies.
PLATFORM_RATE_LIMIT_MODE=noop
PLATFORM_RATE_LIMIT_RPM=60
PLATFORM_RATE_LIMIT_REDIS_URL=redis://localhost:6379/0
PLATFORM_RATE_LIMIT_REDIS_PREFIX=flowbiz:rl
PLATFORM_LLM_PROVIDER=stub
PLATFORM_LLM_MODEL=stub-echo
PLATFORM_SECRET_PROVIDER=env
PLATFORM_SECRET_FILE_PATH=secrets.local.json
PLATFORM_LLM_TIMEOUT_SECONDS=30
PLATFORM_OPENAI_BASE_URL=https://api.openai.com/v1
PLATFORM_OPENAI_API_KEY_SECRET_NAME=OPENAI_API_KEY
PLATFORM_METRICS_MODE=log
PLATFORM_TRACING_MODE=disabled
PLATFORM_ALERTS_MODE=disabled

# Future provider secrets (examples only)
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
